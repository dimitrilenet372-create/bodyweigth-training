rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /workouts/{doc} {
      allow read, write: if true;
    }
    match /sessionHistory/{doc} {
      allow read, write: if true;
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
